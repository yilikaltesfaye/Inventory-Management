{
	"name": "server",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev:docker_create": "docker compose up dev_db -d",
		"dev:docker_up": "docker start postgres",
		"dev:docker_down": "docker stop postgres",
		"dev:docker_logs": "docker logs -f postgres",
		"dev:docker_reset": "docker compose down -v",
		"test": "echo \"Error: no test specified\" && exit 1",
		"seed": "tsx prisma/seed.ts",
		"build": "rimraf dist && npx tsc",
		"start": "npm run build && node dist/index.js",
		"dev": "npm run build && concurrently \"npx tsc -w\" \"nodemon --exec ts-node src/index.ts\"",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:pull": "prisma db pull",
		"db:generate": "prisma generate",
		"db:deploy": "prisma migrate deploy",
		"db:format": "prisma format",
		"db:studio": "prisma studio",
		"db:reset": "prisma migrate reset"
	},
	"keywords": [],
	"author": "Yilikal Tesfaye",
	"license": "ISC",
	"type": "module",
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"body-parser": "^2.3.0",
		"concurrently": "^10.0.5",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"morgan": "^1.11.0",
		"pg": "^8.23.0",
		"rimraf": "^6.1.3"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.2.0",
		"dotenv": "^17.4.2",
		"nodemon": "^3.1.14",
		"prisma": "^7.9.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"deepmerge-ts": "^8.0.0"
	},
	"allowScripts": {
		"prisma@7.9.1": true,
		"@prisma/engines@7.9.1": true,
		"esbuild@0.28.2": true
	}
